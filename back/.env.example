# Copier en `.env` et adapter. Ce fichier-ci est versionné, `.env` ne l'est pas.

SECRET_KEY=changez-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. En local, le conteneur de docker-compose.yml.
DATABASE_URL=postgres://mcm:mcm@localhost:5432/mcm

# La vitrine Next, qui appelle l'API en portant le cookie de session.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3200

# Adresse publique de la vitrine : elle compose les liens envoyés par courriel.
URL_VITRINE=http://localhost:3000

# Adresse publique de ce serveur : elle compose celle des images envoyées.
URL_API=http://localhost:8000

# Courriel. En développement les messages s'écrivent dans la console ; en
# production, remplacer par le backend SMTP du service retenu.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=M comme Maman <bonjour@mcommaman.com>

# ---------------------------------------------------------------- en ligne
#
# Ces mêmes clés se posent chez l'hébergeur, jamais dans un fichier. Ce que
# ça donne une fois la boutique en ligne, à titre d'exemple :
#
#   SECRET_KEY=<50 caractères tirés au hasard, propres à la production>
#   DEBUG=False
#   ALLOWED_HOSTS=mcm-api.onrender.com
#   DATABASE_URL=<l'adresse interne fournie par la base de l'hébergeur>
#   CORS_ALLOWED_ORIGINS=https://mcommaman.vercel.app
#   URL_VITRINE=https://mcommaman.vercel.app
#   URL_API=https://mcm-api.onrender.com
#
# `CORS_ALLOWED_ORIGINS` sert deux fois : les appels du navigateur et les
# origines de confiance pour le CSRF. Une adresse fausse ou oubliée ici, et
# personne ne peut se connecter — c'est la première chose à vérifier.

# ------------------------------------------------ photothèque (Cloudflare R2)
#
# Les cinq vont ensemble : s'il en manque une, les images restent sur le disque
# local. En développement c'est ce qu'on veut ; en ligne aussi, tant qu'un
# disque persistant de l'hébergeur est monté sur `MEDIA_ROOT`. R2 est un choix
# de diffusion (un CDN proche des clientes), pas une nécessité de conservation.
#
# Le domaine public est celui branché sur le bucket. L'adresse `pub-….r2.dev`
# fournie par Cloudflare fait l'affaire pour démarrer ; elle est bridée en
# débit, un domaine personnalisé la remplace quand le trafic le justifie.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=mcommaman-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=
